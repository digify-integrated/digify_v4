# ------------------------------------------------
# Application
# ------------------------------------------------
APP_NAME=Digify
APP_ENV=local                  # Options: local, staging, production
APP_DEBUG=true                 # true = show detailed errors
APP_URL=http://localhost/digify_v4
APP_TIMEZONE=Asia/Manila
APP_KEY=DM3GX9Y9B5Xc6ETRwjl1vP7MK4eukNs5GO53YHV/qow=   # unique secret key

# ------------------------------------------------
# Database (Required)
# ------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digifydb
DB_USER=root
DB_PASS=

# ------------------------------------------------
# Mail (Optional: for password reset, notifications)
# ------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@digify.com
MAIL_FROM_NAME="Digify"

# ------------------------------------------------
# Cache / Session (Optional)
# ------------------------------------------------
SESSION_DRIVER=file              # Options: file, database, redis
CACHE_DRIVER=file                # Options: file, redis, memcached
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ------------------------------------------------
# Third-party API Keys (Optional)
# ------------------------------------------------
GOOGLE_MAPS_API_KEY=
SENDGRID_API_KEY=
STRIPE_API_KEY=

# ------------------------------------------------
# File Uploads / Storage (Optional)
# ------------------------------------------------
STORAGE_PATH=storage
UPLOADS_PATH=storage/uploads

# ------------------------------------------------
# Security / CSRF
# ------------------------------------------------
CSRF_TOKEN_LIFETIME=3600         # seconds

# ------------------------------------------------
# Localization
# ------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
