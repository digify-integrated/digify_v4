# ================================================================
# Application
# ================================================================
APP_NAME=Digify
APP_ENV=local                    # local | staging | production
APP_DEBUG=true                   # true | false
APP_URL=http://localhost/digify_v4
APP_TIMEZONE=Asia/Manila

# Generate this using: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=DM3GX9Y9B5Xc6ETRwjl1vP7MK4eukNs5GO53YHV/qow=

# ================================================================
# Database
# ================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digifydb
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ================================================================
# Mail (Optional)
# ================================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@digify.com
MAIL_FROM_NAME=Digify

# ================================================================
# Sessions / Cache
# ================================================================
SESSION_DRIVER=file              # file | database | redis
CACHE_DRIVER=file                # file | redis | memcached

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================================================
# Third Party Services
# ================================================================
GOOGLE_MAPS_API_KEY=
SENDGRID_API_KEY=
STRIPE_API_KEY=

# ================================================================
# Storage / Uploads
# ================================================================
STORAGE_PATH=storage
UPLOADS_PATH=storage/uploads

# ================================================================
# Security
# ================================================================
CSRF_TOKEN_LIFETIME=3600

# ================================================================
# Localization
# ================================================================
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
